{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.finelycred.com" }],
      "destination": "https://finelycred.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.finelycred.com" }],
      "destination": "https://finelycred.com/:path*",
      "permanent": true
    },
    { "source": "/blog", "destination": "/resources", "permanent": true },
    { "source": "/blog/:slug", "destination": "/resources", "permanent": true }
  ],
  "rewrites": [
    { "source": "/learn", "destination": "/404.html" },
    { "source": "/learn/:path*", "destination": "/404.html" },
    {
      "source": "/(admin|portal|dashboard|onboarding|login|signup|forgot-password|seller|account|preview|owners-guide|business|partner-setup)(/.*)?",
      "destination": "/spa-fallback.html"
    },
    {
      "source": "/au(/.*)?",
      "destination": "/spa-fallback.html"
    },
    {
      "source": "/unsubscribe",
      "destination": "/spa-fallback.html"
    },
    {
      "source": "/((?!assets/|resources/|credit-analysis/|brand/|tours/|images/|guides/|feeds/|media/|staff/|staff-portraits/|\\.well-known/).*)",
      "destination": "/spa-fallback.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
