{
  "policy": {
    "temperature": "cold",
    "sendEmail": false,
    "sendSms": false,
    "commitPii": false,
    "notes": "Organization and employer-posting records from public directories and official APIs. People do not know Finely has this information. Do not email, text, or enroll nurture. Real exports are *.local.json / *.local.csv and must stay gitignored."
  },
  "lanes": [
    {
      "id": "affiliates",
      "label": "Affiliates / referral partners",
      "who": "HUD-approved housing counseling agencies, credit-counseling nonprofits, and Haitian chambers or professional associations in FL/NY (plus nearby NJ/MA Haitian corridors).",
      "optInPath": "/affiliate"
    },
    {
      "id": "specialists",
      "label": "Credit specialists / counseling offices",
      "who": "Public counseling agencies that publish financial-management or credit workshop services (HUD FBC/FBW) and nonprofit credit-counseling organizations. This lane is offices, not personal resumes of individual loan officers.",
      "optInPath": "/credit-specialist"
    },
    {
      "id": "jobs",
      "label": "Credit and debt hiring demand",
      "who": "Employer job postings whose titles match credit, loan, debt, or housing-counselor roles. Not job-seeker resumes and not personal contact details.",
      "optInPath": "/credit-specialist"
    },
    {
      "id": "haitian_orgs",
      "label": "Haitian community organizations",
      "who": "IRS-exempt organizations whose public name matches Haitian/Ayisyen searches, plus HUD agencies that publish Haitian Creole (language code CRE).",
      "optInPath": "/free-kreyol-guide"
    }
  ],
  "propublica": {
    "endpoint": "https://projects.propublica.org/nonprofits/api/v2/search.json",
    "docs": "https://projects.propublica.org/nonprofits/api",
    "provenance": "IRS EO BMF via ProPublica Nonprofit Explorer. Returns organization name, EIN, city, state, and NTEE code. No personal emails.",
    "queries": [
      { "q": "haitian", "state": "FL", "lanes": ["haitian_orgs"], "maxPages": 2 },
      { "q": "haitian", "state": "NY", "lanes": ["haitian_orgs"], "maxPages": 2 },
      { "q": "haitian", "state": "NJ", "lanes": ["haitian_orgs"], "maxPages": 2 },
      { "q": "haitian", "state": "MA", "lanes": ["haitian_orgs"], "maxPages": 2 },
      { "q": "credit counseling", "state": "FL", "lanes": ["specialists", "affiliates"], "maxPages": 2 },
      { "q": "credit counseling", "state": "NY", "lanes": ["specialists", "affiliates"], "maxPages": 2 },
      { "q": "credit counseling", "state": "NJ", "lanes": ["specialists", "affiliates"], "maxPages": 1 },
      { "q": "housing counseling", "state": "FL", "lanes": ["affiliates"], "maxPages": 1 },
      { "q": "housing counseling", "state": "NY", "lanes": ["affiliates"], "maxPages": 1 }
    ]
  },
  "hud": {
    "endpoint": "https://data.hud.gov/Housing_Counselor/searchByLocation",
    "docs": "https://data.hud.gov/",
    "provenance": "HUD housing counselor locator. Public agency name, address, phone, email, website, services, and languages. Organizational contacts published so consumers can find counseling. Treat as cold: do not email.",
    "distanceMiles": 25,
    "kreyolLanguageCode": "CRE",
    "creditServiceCodes": ["FBC", "FBW"],
    "serviceCodeNotes": {
      "FBC": "Financial Management/Budget Counseling",
      "FBW": "Financial, Budgeting, and Credit Workshops",
      "CRE": "Haitian Creole language code on the HUD locator"
    },
    "metros": [
      { "id": "miami", "label": "Miami, FL", "lat": 25.7617, "lng": -80.1918 },
      { "id": "fort-lauderdale", "label": "Fort Lauderdale, FL", "lat": 26.1224, "lng": -80.1373 },
      { "id": "west-palm", "label": "West Palm Beach, FL", "lat": 26.7153, "lng": -80.0534 },
      { "id": "orlando", "label": "Orlando, FL", "lat": 28.5383, "lng": -81.3792 },
      { "id": "tampa", "label": "Tampa, FL", "lat": 27.9506, "lng": -82.4572 },
      { "id": "naples", "label": "Naples, FL", "lat": 26.142, "lng": -81.7948 },
      { "id": "brooklyn", "label": "Brooklyn, NY", "lat": 40.6782, "lng": -73.9442 },
      { "id": "queens", "label": "Queens, NY", "lat": 40.7282, "lng": -73.7949 },
      { "id": "bronx", "label": "Bronx, NY", "lat": 40.8448, "lng": -73.8648 },
      { "id": "manhattan", "label": "Manhattan, NY", "lat": 40.7831, "lng": -73.9712 },
      { "id": "spring-valley", "label": "Spring Valley, NY", "lat": 41.1126, "lng": -74.044 },
      { "id": "newark", "label": "Newark, NJ", "lat": 40.7357, "lng": -74.1724 },
      { "id": "boston", "label": "Boston, MA", "lat": 42.3601, "lng": -71.0589 }
    ]
  },
  "jobs": {
    "titlePattern": "\\b(credit counselor|credit specialist|credit analyst|loan officer|mortgage loan originator|debt counselor|debt specialist|housing counselor|credit repair specialist)\\b",
    "apis": [
      {
        "id": "remotive",
        "url": "https://remotive.com/api/remote-jobs?search=credit%20counselor",
        "docs": "https://remotive.com/remote-jobs/api",
        "listPath": "jobs",
        "titleField": "title",
        "orgField": "company_name",
        "locationField": "candidate_required_location",
        "urlField": "url"
      },
      {
        "id": "remoteok",
        "url": "https://remoteok.com/api",
        "docs": "https://remoteok.com/api",
        "listPath": "",
        "titleField": "position",
        "orgField": "company",
        "locationField": "location",
        "urlField": "url"
      },
      {
        "id": "arbeitnow",
        "url": "https://www.arbeitnow.com/api/job-board-api",
        "docs": "https://www.arbeitnow.com/api/job-board-api",
        "listPath": "data",
        "titleField": "title",
        "orgField": "company_name",
        "locationField": "location",
        "urlField": "url"
      }
    ],
    "manualQueries": [
      {
        "source": "Indeed",
        "automation": "manual only — automated fetches return 403 and bulk scraping is out of policy",
        "queries": [
          "credit counselor — Miami, FL",
          "credit counselor — Brooklyn, NY",
          "loan officer — Fort Lauderdale, FL",
          "mortgage loan originator — Queens, NY",
          "debt specialist — Orlando, FL",
          "housing counselor — Spring Valley, NY"
        ]
      },
      {
        "source": "LinkedIn Jobs",
        "automation": "manual only — no logged-in scrape",
        "queries": [
          "Credit Counselor Florida",
          "Loan Officer Brooklyn",
          "Housing Counselor Miami",
          "Credit Repair Specialist New York"
        ]
      },
      {
        "source": "USAJOBS",
        "automation": "manual search, or the official API with a developer key. This collector does not call USAJOBS without a key.",
        "urls": [
          "https://www.usajobs.gov/Search/Results?k=credit%20counselor&l=Florida",
          "https://www.usajobs.gov/Search/Results?k=loan%20specialist&l=New%20York"
        ]
      },
      {
        "source": "NMLS Consumer Access",
        "automation": "manual single-licensee lookup only. Do not bulk-export loan officer records.",
        "url": "https://www.nmlsconsumeraccess.org/"
      },
      {
        "source": "NCUA credit union locator",
        "automation": "manual. Credit unions are referral-partner candidates; do not request member lists.",
        "url": "https://mapping.ncua.gov/"
      },
      {
        "source": "Google",
        "automation": "manual",
        "queries": [
          "\"credit counselor\" hiring Miami",
          "\"loan officer\" jobs Brooklyn",
          "\"Haitian\" \"chamber of commerce\" Florida",
          "\"housing counseling agency\" \"Creole\" Miami"
        ]
      }
    ]
  }
}
