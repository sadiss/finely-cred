{
  "policy": {
    "temperature": "cold",
    "sendEmail": false,
    "sendSms": false,
    "commitPii": false,
    "notes": "Organization and employer-posting records from public directories and official APIs. People do not know Finely has this information. Do not email, text, or enroll nurture. Real exports are *.local.json / *.local.csv / *.local.md and must stay gitignored. Wave 2 widens metros, keywords, states, and pages. It does not invent contacts."
  },
  "lanes": [
    {
      "id": "affiliates",
      "label": "Affiliates / referral partners",
      "who": "HUD-approved housing counseling agencies, credit-counseling nonprofits, chambers and associations, and nonprofits with referral-relevant NTEE codes (S community, L housing, P51 financial counseling, P20 human services, P84 immigrant services) in Haitian-diaspora and credit-counseling markets.",
      "optInPath": "/affiliate"
    },
    {
      "id": "specialists",
      "label": "Credit specialists / counseling offices",
      "who": "Public counseling agencies that publish financial-management or credit workshop services (HUD FBC/FBW), nonprofit credit-counseling and financial-literacy organizations, and offices whose public name is a credit-counseling practice. This lane is offices, not personal resumes of individual loan officers.",
      "optInPath": "/credit-specialist"
    },
    {
      "id": "jobs",
      "label": "Credit and debt hiring demand",
      "who": "Employer job postings whose titles match credit, loan, debt, housing-counselor, or financial-coach roles. Not job-seeker resumes and not personal contact details.",
      "optInPath": "/credit-specialist"
    },
    {
      "id": "haitian_orgs",
      "label": "Haitian community organizations",
      "who": "IRS-exempt organizations matched on Haitian, Haiti, Kreyol, Ayisyen, and filtered Creole names, plus HUD agencies that publish Haitian Creole (language code CRE).",
      "optInPath": "/free-kreyol-guide"
    }
  ],
  "propublica": {
    "endpoint": "https://projects.propublica.org/nonprofits/api/v2/search.json",
    "docs": "https://projects.propublica.org/nonprofits/api",
    "provenance": "IRS EO BMF via ProPublica Nonprofit Explorer. Returns organization name, EIN, city, state, and NTEE code. No personal emails. Pagination follows num_pages until the catalog cap.",
    "includeNational": true,
    "maxPages": 120,
    "states": ["FL", "NY", "NJ", "MA", "GA", "TX", "PA", "MD", "DC", "IL", "NC", "CA", "CT", "RI", "LA"],
    "stateNotes": "Wave 1 queried FL/NY/NJ/MA only, two pages at most. Wave 2 exhausts these focus states and a national pass. A 404 from the API is an empty state/keyword, not a fabricated zero.",
    "filterNotes": "Creole and Caribbean searches are fuzzy on this API (they also return Create, Creede, and unrelated Caribbean businesses). Those two keywords require a whole-word name match, a community/service relevance word, and a junk exclusion. Other keywords require the name to contain the topic so fuzzy misses are dropped. No emails are invented.",
    "keywords": [
      {
        "q": "haitian",
        "lanes": ["haitian_orgs"],
        "nameMustMatch": "haiti"
      },
      {
        "q": "haiti",
        "lanes": ["haitian_orgs"],
        "nameMustMatch": "haiti"
      },
      {
        "q": "kreyol",
        "lanes": ["haitian_orgs"],
        "nameMustMatch": "kreyol|creole|haiti"
      },
      {
        "q": "ayisyen",
        "lanes": ["haitian_orgs"],
        "nameMustMatch": "ayisyen|haiti"
      },
      {
        "q": "creole",
        "lanes": ["haitian_orgs"],
        "nameMustMatch": "\\bcreole\\b",
        "nameMustNotMatch": "restaurant|cuisine|kitchen|catering|\\bbakery\\b|\\bgrill\\b|\\bcafe\\b|soiree|festival|carnival|acadien|cajun",
        "relevanceMustMatch": "community|association|alliance|coalition|foundation|network|society|chamber|federation|heritage|cultural|culture|education|school|language|church|ministry|mission|immigrant|refugee|counsel|housing|credit|financial|literacy|resource|services|service|outreach|civic|family|youth|center|centre|organization|kreyol|haitian|haiti|ayisyen"
      },
      {
        "q": "caribbean",
        "lanes": ["affiliates"],
        "nameMustMatch": "\\bcaribbean\\b",
        "nameMustNotMatch": "restaurant|cuisine|kitchen|catering|festival|carnival|wildlife|ecology|\\bkite\\b|volleyball|broadcast|canine|aircare|stranding|biodiversity|theatre|theater|masonic|balloon|ridazz|university|\\bcollege\\b|\\bcreate\\b|creede",
        "relevanceMustMatch": "community|association|alliance|coalition|foundation|network|society|chamber|federation|heritage|cultural|culture|education|school|language|church|ministry|mission|immigrant|refugee|counsel|housing|credit|financial|literacy|resource|services|service|outreach|civic|women|family|youth|health|legal|center|centre|organization|hope|blessing|partnership|roots|support|advisory"
      },
      {
        "q": "credit counseling",
        "lanes": ["specialists", "affiliates"],
        "nameMustMatch": "credit|counsel|debt|budget|consumer|financ"
      },
      {
        "q": "housing counseling",
        "lanes": ["specialists", "affiliates"],
        "nameMustMatch": "hous|counsel|home|mortgage|foreclos"
      },
      {
        "q": "financial literacy",
        "lanes": ["specialists", "affiliates"],
        "nameMustMatch": "financ|literac|credit|money|budget|counsel"
      },
      {
        "q": "financial education",
        "lanes": ["specialists", "affiliates"],
        "nameMustMatch": "financ|educat|literac|credit|money|budget"
      },
      {
        "q": "financial counseling",
        "lanes": ["specialists", "affiliates"],
        "nameMustMatch": "financ|counsel|credit|debt|budget"
      },
      {
        "q": "credit education",
        "lanes": ["specialists", "affiliates"],
        "nameMustMatch": "credit|counsel|debt|financ|educat"
      },
      {
        "q": "consumer credit",
        "lanes": ["specialists", "affiliates"],
        "nameMustMatch": "credit"
      },
      {
        "q": "debt management",
        "lanes": ["specialists", "affiliates"],
        "nameMustMatch": "debt|credit|counsel|budget"
      },
      {
        "q": "immigrant services",
        "lanes": ["affiliates"],
        "nameMustMatch": "immigrant|refugee"
      },
      {
        "q": "homeownership",
        "lanes": ["specialists", "affiliates"],
        "nameMustMatch": "homeownership|home ownership|housing|credit"
      },
      {
        "q": "foreclosure prevention",
        "lanes": ["specialists", "affiliates"],
        "nameMustMatch": "foreclos|housing|counsel|home"
      },
      {
        "q": "housing counselor",
        "lanes": ["specialists", "affiliates"],
        "nameMustMatch": "hous|counsel|home"
      }
    ]
  },
